[Unit]
Description=PicoShogun Command Centre for the Pico Security Series
After=network.target

[Service]
Type=simple
User=kirk
Group=kirk
WorkingDirectory=/home/kirk/Madlab/Clean-Live/Shogun
Environment=PICOSHOGUN_ENV=production
Environment=PYTHONPATH=/home/kirk/Madlab/Clean-Live/Shogun
ExecStart=/home/kirk/Madlab/Clean-Live/Shogun/venv/bin/python -m uvicorn api.server:app --host 0.0.0.0 --port 8765 --workers 4
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=picoshogun

[Install]
WantedBy=multi-user.target
