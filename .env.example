# PicoShogun Environment Configuration
# Copy this to .env and customize for your deployment

# Environment
PICOSHOGUN_ENV=development  # backward compat: SHOGUN_ENV
PICOSHOGUN_DEBUG=false

# Security
PICOSHOGUN_SECRET_KEY=your-super-secret-key-change-this-in-production
PICOSHOGUN_DDOS_SHIELD=false

# CORS — set explicit origins in production (comma-separated)
# Example: PICOSHOGUN_CORS_ORIGINS=https://app.example.com,https://admin.example.com
PICOSHOGUN_CORS_ORIGINS=

# Database
PICOSHOGUN_DB_PATH=data/picoshogun.db
PICOSHOGUN_BACKUP_DIR=data/backups

# API
PICOSHOGUN_API_HOST=127.0.0.1
PICOSHOGUN_API_PORT=8765
PICOSHOGUN_API_WORKERS=4

# Audit Retention
PICOSHOGUN_AUDIT_RETENTION_DAYS=90

# Alerts
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
EMAIL_FROM=picoshogun@localhost

# Orchestrator
PICOSHOGUN_MAX_CONCURRENT=5
PICOSHOGUN_DEFAULT_TIMEOUT=300
PICOSHOGUN_RETRY_FAILED=true
PICOSHOGUN_RETRY_MAX=3
