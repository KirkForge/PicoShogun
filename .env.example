# Secdev_kimi Enterprise Environment Configuration
# Copy this to .env and customize for your deployment

# Environment
SECDEV_ENV=development
SECDEV_DEBUG=false

# Security
SECDEV_SECRET_KEY=your-super-secret-key-change-this-in-production

# Database
SECDEV_DB_PATH=/home/kirk/.picoclaw/workspace/Secdev_kimi/secdev_kimi.db
SECDEV_BACKUP_DIR=/home/kirk/.picoclaw/workspace/Secdev_kimi/backups

# API
SECDEV_API_HOST=0.0.0.0
SECDEV_API_PORT=8765
SECDEV_API_WORKERS=4

# Alerts
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
EMAIL_FROM=secdev@localhost

# Orchestrator
SECDEV_MAX_CONCURRENT=5
SECDEV_DEFAULT_TIMEOUT=300
SECDEV_RETRY_FAILED=true
SECDEV_RETRY_MAX=3
