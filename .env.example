# Shogun Enterprise Environment Configuration
# Copy this to .env and customize for your deployment

# Environment
SHOGUN_ENV=development
SHOGUN_DEBUG=false

# Security
SHOGUN_SECRET_KEY=your-super-secret-key-change-this-in-production
SHOGUN_DDOS_SHIELD=false

# CORS — set explicit origins in production (comma-separated)
# Example: SHOGUN_CORS_ORIGINS=https://app.example.com,https://admin.example.com
SHOGUN_CORS_ORIGINS=

# Database
SHOGUN_DB_PATH=/home/kirk/Madlab/Clean-Live/Shogun/shogun.db
SHOGUN_BACKUP_DIR=/home/kirk/Madlab/Clean-Live/Shogun/backups

# API
SHOGUN_API_HOST=0.0.0.0
SHOGUN_API_PORT=8765
SHOGUN_API_WORKERS=4

# Audit Retention
SHOGUN_AUDIT_RETENTION_DAYS=90

# Alerts
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
EMAIL_FROM=shogun@localhost

# Orchestrator
SHOGUN_MAX_CONCURRENT=5
SHOGUN_DEFAULT_TIMEOUT=300
SHOGUN_RETRY_FAILED=true
SHOGUN_RETRY_MAX=3
